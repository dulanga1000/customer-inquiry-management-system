# ==============================================================================
# CIMS Environment Configuration
# Copy this file to .env for local development. Docker Compose works out of the
# box with built-in defaults even without creating a .env file.
# ==============================================================================

# --- PostgreSQL (Docker Compose / Local) ---
POSTGRES_USER=cims
POSTGRES_PASSWORD=cims_dev_password
POSTGRES_DB=cims
POSTGRES_PORT=5432

# Local host connection string (used when running API/migrations/seeds on host)
DATABASE_URL=postgresql://cims:cims_dev_password@localhost:5432/cims

# Docker internal connection string (used inside the api container)
DOCKER_DATABASE_URL=postgresql://cims:cims_dev_password@db:5432/cims

# Hosted PostgreSQL (Supabase) example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Isolated test database (for backend integration tests)
TEST_DATABASE_URL=postgresql://cims:cims_dev_password@localhost:5432/cims_test

# --- API Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- Auth & Cookies ---
# Replace with a long random string (at least 32 chars) in non-local environments
JWT_ACCESS_SECRET=cims-local-dev-jwt-access-secret-change-in-prod
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# --- Web Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
