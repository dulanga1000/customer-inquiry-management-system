# PostgreSQL
POSTGRES_USER=cims
POSTGRES_PASSWORD=cims_dev_password
POSTGRES_DB=cims
POSTGRES_PORT=5432
DATABASE_URL="postgresql://cims:cims_dev_password@localhost:5432/cims?schema=public"
DOCKER_DATABASE_URL="postgresql://cims:cims_dev_password@db:5432/cims?schema=public"
TEST_DATABASE_URL="postgresql://cims:cims_dev_password@localhost:5432/cims_test?schema=public"

# API Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Auth & Cookies
JWT_ACCESS_SECRET=cims-local-dev-jwt-access-secret-change-in-prod
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
