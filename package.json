{
  "name": "customer-inquiry-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter @cims/api dev",
    "dev:web": "pnpm --filter @cims/web dev",
    "build": "pnpm --filter @cims/shared build && pnpm --filter @cims/api build && pnpm --filter @cims/web build",
    "migrate": "pnpm --filter @cims/api migrate",
    "seed": "pnpm --filter @cims/api seed",
    "typecheck": "pnpm --filter @cims/shared typecheck && pnpm --filter @cims/api typecheck && pnpm --filter @cims/web exec tsc --noEmit",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0"
}
